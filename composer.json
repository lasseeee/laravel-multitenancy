{
    "name": "lasseeee/laravel-multitenancy",
    "description": "Make your Laravel app usable by multiple tenants",
    "keywords": [
        "lasseeee",
        "laravel-multitenancy"
    ],
    "homepage": "https://github.com/lasseeee/laravel-multitenancy",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Lasseeee\\Multitenancy\\": "src"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Lasseeee\\Multitenancy\\MultitenancyServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
